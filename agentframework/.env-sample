AZURE_OPENAI_EMBEDDING_DEPLOYMENT="text-embedding-ada-002" 
AZURE_OPENAI_RESPONSES_DEPLOYMENT_NAME="gpt-5.2-responses"

# AKS runtime
ENVIRONMENT="dev"
PORT="8000"
WORKERS="1"
TIMEOUT="60"

# Observability
APPINSIGHTS_CONNECTION_STRING=""
OTEL_SERVICE_NAME="agentframework"
OTEL_EXPORTER_OTLP_ENDPOINT=""

# Identity (use Workload Identity or Service Principal)
AZURE_CLIENT_ID=""
AZURE_TENANT_ID=""
AZURE_CLIENT_SECRET=""

# Fitness durable memory backend
FITNESS_DB_BACKEND="sqlite"
FITNESS_DB_PATH="agentframework.db"

# Azure SQL migration/runtime settings
AZURE_SQL_ADMIN_USER=""
AZURE_SQL_ADMIN_PASSWORD=""
AZURE_SQL_SERVER_RESOURCE_GROUP="app-service-linux"
AZURE_SQL_SERVER_SUBSCRIPTION_ID=""
AZURE_SQL_SERVER=""
AZURE_SQL_DATABASE=""
AZURE_SQL_SCHEMA="dbo"
AZURE_SQL_DRIVER="ODBC Driver 18 for SQL Server"
AZURE_SQL_AUTH_MODE="defaultazurecredential"
AZURE_SQL_ENCRYPT="true"
AZURE_SQL_TRUST_SERVER_CERTIFICATE="false"
AZURE_SQL_CONNECTION_TIMEOUT="30"
AZURE_SQL_RESOURCE_GROUP=""
AZURE_SQL_LOCATION=""
AZURE_SQL_ENTRA_ADMIN_NAME=""
