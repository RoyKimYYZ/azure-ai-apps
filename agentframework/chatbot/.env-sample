# Starter template for the Streamlit chatbot.
# Copy this file to chatbot/.env and replace placeholder values.

# Azure OpenAI / AI Foundry
AZURE_OPENAI_ENDPOINT="https://your-resource-name.openai.azure.com/"
AZURE_OPENAI_API_KEY="<your-azure-openai-api-key>"
AZURE_OPENAI_API_VERSION="2024-08-01-preview"
AZURE_OPENAI_EMBEDDING_DEPLOYMENT="text-embedding-ada-002"
AZURE_OPENAI_CHAT_DEPLOYMENT_NAME="gpt-5.2-chat"
AZURE_OPENAI_RESPONSES_DEPLOYMENT_NAME="gpt-5.2-responses"

# Chatbot provider config used by chatbot/config.yaml
AI_FOUNDRY_ENDPOINT="https://your-resource-name.openai.azure.com/"
AI_FOUNDRY_API_KEY="<your-ai-foundry-api-key>"
AI_FOUNDRY_MODEL="gpt-5.2-chat"
AI_FOUNDRY_MODELS="gpt-5.2-chat,DeepSeek-V3.2,gpt-5-mini"

# KAITO direct inference
# Use a localhost URL when testing from outside the cluster with kubectl port-forward.
KAITO_INFERENCE_ENDPOINT="http://127.0.0.1:8000/v1/chat/completions"
KAITO_MODEL="phi-4-mini-instruct"

# KAITO RAG Engine
KAITO_RAGENGINE_ENDPOINT="http://127.0.0.1:8001/v1/chat/completions"
KAITO_RAGENGINE_INDEX="rag_index"

# Optional UI / diagnostics
DEBUG_LOG_MAX_LINES="200"
LOG_LEVEL="INFO"

# Optional GitHub MCP auth
GH_PAT=""
GITHUB_TOKEN=""

# AKS runtime
ENVIRONMENT="dev"
PORT="8000"
WORKERS="1"
TIMEOUT="60"

# Observability
APPINSIGHTS_CONNECTION_STRING=""
OTEL_SERVICE_NAME="agentframework-chatbot"
OTEL_EXPORTER_OTLP_ENDPOINT=""

# Identity (use Workload Identity, Azure CLI, or Service Principal)
AZURE_CLIENT_ID=""
AZURE_TENANT_ID=""
AZURE_CLIENT_SECRET=""

# Fitness durable memory backend
# Default to SQLite for first-time local setup.
FITNESS_DB_BACKEND="sqlite"
FITNESS_DB_PATH="agentframework.db"

# Azure SQL runtime settings
# Only required when FITNESS_DB_BACKEND="azuresql".
AZURE_SQL_ADMIN_USER=""
AZURE_SQL_ADMIN_PASSWORD=""
AZURE_SQL_SERVER_RESOURCE_GROUP=""
AZURE_SQL_SERVER_SUBSCRIPTION_ID=""
AZURE_SQL_SERVER="<logical-server-name>.database.windows.net"
AZURE_SQL_DATABASE="<database-name>"
AZURE_SQL_SCHEMA="dbo"
AZURE_SQL_DRIVER="ODBC Driver 18 for SQL Server"
AZURE_SQL_AUTH_MODE="defaultazurecredential"
AZURE_SQL_ENCRYPT="true"
AZURE_SQL_TRUST_SERVER_CERTIFICATE="false"
AZURE_SQL_CONNECTION_TIMEOUT="30"
AZURE_SQL_RESOURCE_GROUP=""
AZURE_SQL_LOCATION=""
AZURE_SQL_ENTRA_ADMIN_NAME=""
AZURE_SQL_ENTRA_ADMIN_OBJECT_ID=""