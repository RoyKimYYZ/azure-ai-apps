apiVersion: v1
kind: Secret
metadata:
  name: agentframework-chatbot-secrets
type: Opaque
stringData:
  AZURE_OPENAI_API_KEY: ""
  AI_FOUNDRY_API_KEY: ""
  AZURE_CLIENT_ID: ""
  AZURE_TENANT_ID: ""
  AZURE_CLIENT_SECRET: ""
  APPINSIGHTS_CONNECTION_STRING: ""
  # ──────────────────────────────────────────
  # OAuth Provider Credentials (for AKS deployment)
  # ──────────────────────────────────────────
  # Only set when external_identities.enabled=true in appconfig.yaml
  # Get these values from your OAuth provider registration portals
  
  # Microsoft Entra ID / Azure AD
  OAUTH_MICROSOFT_CLIENT_ID: ""
  OAUTH_MICROSOFT_CLIENT_SECRET: ""
  OAUTH_MICROSOFT_TENANT_ID: ""  # Optional: only needed for tenant-specific authority instead of /common
  
  # Google OAuth 2.0
  OAUTH_GOOGLE_CLIENT_ID: ""
  OAUTH_GOOGLE_CLIENT_SECRET: ""
  
  # Twitter / X OAuth 2.0
  OAUTH_TWITTER_CLIENT_ID: ""
  OAUTH_TWITTER_CLIENT_SECRET: ""
